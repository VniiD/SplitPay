@using SplitPayment.Domain.Pos

<div role="img" aria-label="Distribuição do valor da venda">
    <svg class="bar-svg" viewBox="0 0 1000 16" preserveAspectRatio="none" aria-hidden="true">
        @{ var x = 0.0; }
        @foreach (var line in Split.Lines.Where(line => line.Retained && line.Amount.Cents > 0))
        {
            var width = Split.Gross.Cents == 0 ? 0 : 1000.0 * line.Amount.Cents / Split.Gross.Cents;
            <rect x="@x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" y="0" height="16" width="@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="@SegmentClass(line.Kind)" />
            x += width;
        }
    </svg>
</div>
<div class="legend">
    <span><i class="l-net"></i>Lojista</span>
    <span><i class="l-fee"></i>Taxa (MDR)</span>
    <span><i class="l-tax"></i>Tributos retidos</span>
    <span><i class="l-recipient"></i>Recebedores</span>
</div>
<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Beneficiário</th><th>Descrição</th><th class="num">%</th><th class="num">Valor</th></tr></thead>
        <tbody>
            @foreach (var line in Split.Lines)
            {
                <tr>
                    <td>@line.Beneficiary</td>
                    <td>@line.Description</td>
                    <td class="num">@((line.BasisPoints / 100m).ToString("0.00"))</td>
                    <td class="num">@line.Amount.Display</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><th colspan="3">Valor bruto da venda</th><th class="num">@Split.Gross.Display</th></tr>
        </tfoot>
    </table>
</div>
@if (Split.TaxTreatment == "Informative2026")
{
    <p class="note">Fase de teste 2026: IBS (0,1%) e CBS (0,9%) são exibidos apenas como informação e não são retidos nem recolhidos nesta simulação.</p>
}

@code {
    [Parameter, EditorRequired] public SplitDto Split { get; set; } = default!;

    private static string SegmentClass(string kind) => kind switch
    {
        nameof(SplitLineKind.Merchant) => "seg-net",
        nameof(SplitLineKind.AcquirerFee) => "seg-fee",
        nameof(SplitLineKind.Recipient) => "seg-recipient",
        _ => "seg-tax"
    };
}
